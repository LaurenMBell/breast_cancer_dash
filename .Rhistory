#############################################
## You may run this multiple times, make sure to update alpha, beta, observations as needed
## Simulate Gamma Random Variable
RV = rgamma(observations,alpha,1/beta)
## Plot Random Variable
hist(RV, freq = FALSE, col = "seagreen", breaks = 100,
main = "Gamma Random Variable Values with Density Curve",
xlim=c(0,max(RV)+sqrt(alpha*beta^2)))
## Plot Probability Density Curve over Histogram
x.range =  seq(0, max(RV)+2*sqrt(alpha*beta^2), 0.01)
pdf = dgamma(x.range,alpha,1/beta)
lines(x.range, pdf, lwd = 4)
## Calculate Proportion of values below 6
Proportion = sum(RV<6)/observations
Proportion
#######################
## End of Simulation ##
